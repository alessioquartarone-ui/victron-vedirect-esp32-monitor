# Private compile-time user config
Victron_Display_Web/config_user.h
Victron_Display_Web/secrets.h

# Firmware build outputs
*.bin
*.elf
*.map
*.hex
*.uf2
*.partitions.bin
*.bootloader.bin

# Arduino / build folders
build/
dist/
.cache/
arduino-build-*/
arduino-cache-*/

# PlatformIO, if used by contributors
.pio/
platformio.ini.bak

# IDE folders
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Logs / temporary files
*.log
*.tmp
*.bak

# Local exported configs/backups
backup/
backups/
exports/
logs/

# Do not commit local generated firmware artifacts
firmware/latest.bin
firmware/version.txt
firmware/latest.sha256
